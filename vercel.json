{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/celesterosaFE/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://celesterosa-api.onrender.com/api/:path*" },
    { "source": "/api-docs", "destination": "https://celesterosa-api.onrender.com/api-docs/" },
    { "source": "/api-docs/:path*", "destination": "https://celesterosa-api.onrender.com/api-docs/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
